# Environment template for Reality Reveal (Reveal DQ + Reveal VoC)
# Copy to .env and fill in real values. Never commit .env.

# MySQL (local)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_WAREHOUSE_DB=RevealDQ
MYSQL_CTRL_DB=RevealDQ_ctrl
# Reveal VoC raw + derived data. Created automatically by the API if missing.
MYSQL_VOC_DB=VOC_DB

# Reveal VoC — LinkedIn extraction
# Default: credential-less Playwright scrape of LinkedIn's public pages
# (agents/linkedin_scraper.py). Nothing to configure. Chromium is installed
# into .tools/playwright by scripts/run-agent.sh; override the location with:
# PLAYWRIGHT_BROWSERS_PATH=/abs/path
#
# Legacy / optional — LinkedIn official API via OAuth 2.0 (OFFICIAL_API source).
# Not offered in the UI any more; leave blank unless you re-enable it.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8080/api/v1/voc/linkedin/oauth/callback
# Shown as the account the user is expected to sign in with (login_hint).
LINKEDIN_ACCOUNT_EMAIL=Harish.aiproject.lib@gmail.com
# Where the browser is sent back after LinkedIn consent.
UI_URL=http://127.0.0.1:4200

# Go API
API_ADDR=:8080
# Long random string. The API refuses to start on the placeholder unless
# ALLOW_INSECURE_DEV=1 (local demo only). Also used as the agent handoff token.
JWT_SECRET=change-me-in-production
# Optional. When empty, connection secrets are encrypted with a key derived from JWT_SECRET.
DATA_ENCRYPTION_KEY=
# Base URL the Python agent uses to redeem warehouse credentials (no password in /chat).
API_URL=http://127.0.0.1:8080
ADMIN_EMAIL=admin@revealdq.local
ADMIN_PASSWORD=Admin@123
ADMIN_DISPLAY_NAME=Reveal DQ Admin
AGENT_URL=http://127.0.0.1:8090

# Python agent / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MODEL_CHEAP=claude-3-5-haiku-20241022
AGENT_ADDR=:8090

# DQ Analyser data-access channel
# The agent inspects data sets over an MCP channel (agents/mcp_server.py) by default.
# Set DQ_MCP_ENABLED=0 to force a direct MySQL connection instead.
DQ_MCP_ENABLED=1
# Whole-database profiling guard-rails
DQ_MAX_TABLES=60
DQ_MAX_COLS=40
DQ_NULL_THRESHOLD=5.0
